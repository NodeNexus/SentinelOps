# ================================
# SentinelOps AI — Environment Variables
# Copy this to apps/api/.env and fill in real values.
# NEVER commit the actual .env file.
# ================================

# --- PostgreSQL ---
DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinelops?schema=public"

# --- JWT ---
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET="change-me-to-a-strong-random-secret"

# --- API Server ---
PORT=4000

# --- Google Gemini ---
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- Frontend (Next.js) ---
# Set in apps/web/.env.local for local dev, or as an environment variable in your hosting platform
NEXT_PUBLIC_API_URL="http://localhost:4000"
